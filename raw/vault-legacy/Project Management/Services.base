filters:
  and:
    - file.hasTag("service")
    - file.ext == "md"
formulas:
  status_badge: if(service_status == "running", "🟢 Running", if(service_status == "stopped", "🔴 Stopped", "🟡 Degraded"))
properties:
  service_status:
    displayName: Status
  port:
    displayName: Port
  image:
    displayName: Docker Image
views:
  - type: table
    name: All Services
    order:
      - formula.status_badge
      - file.name
      - port
      - image
      - description
  - type: cards
    name: Service Cards
    order:
      - formula.status_badge
      - file.name
      - port
      - description
